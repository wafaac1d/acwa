# Copy to .env and replace secrets before any shared or live deployment.
# The Fernet key below is a local development key. Live mode refuses to start with it.

ACWA_DATABASE_URL=postgresql+psycopg://acwa:acwa@localhost:5432/acwa
ACWA_INTEGRATION_MODE=demo
ACWA_DEMO_SEED=true
ACWA_TOKEN_ENCRYPTION_KEY=LT9kgrT3RvPvRfszF9yrxTTVqCqlwnkN7nlzgzwzjLo=
# Required. The UI and API stay closed until this password is entered.
# At least 12 characters. Do not commit a real password.
ACWA_AUTH_TOKEN=replace-with-a-long-random-password
ACWA_DEEPSEEK_API_KEY=
ACWA_DEEPSEEK_BASE_URL=https://api.deepseek.com
ACWA_DEEPSEEK_MODEL=deepseek-flash
ACWA_DEEPSEEK_TIMEOUT_SECONDS=60
ACWA_DEEPSEEK_MAX_RETRIES=2
ACWA_DEEPSEEK_TEMPERATURE=0.8
ACWA_DEEPSEEK_MAX_TOKENS=512
ACWA_THREADS_GRAPH_BASE_URL=https://graph.threads.com
ACWA_THREADS_OAUTH_AUTHORIZE_URL=https://threads.com/oauth/authorize
ACWA_THREADS_APP_ID=
ACWA_THREADS_APP_SECRET=
ACWA_THREADS_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/threads/callback
ACWA_THREADS_TIMEOUT_SECONDS=30
ACWA_THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights
ACWA_FRONTEND_ORIGIN=http://127.0.0.1:5173
ACWA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ACWA_WORKER_POLL_SECONDS=2
ACWA_WORKER_LEASE_SECONDS=300
ACWA_MISSED_SLOT_GRACE_SECONDS=900
ACWA_LOG_LEVEL=INFO
